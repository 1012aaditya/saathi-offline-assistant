<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Voice: Android's built-in speech recognizer (step 1; no API keys, no INTERNET permission in this app). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Walk mode (camera preview arrives in a later step; asked for during setup). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!-- Apps Saathi may open by voice (safety Apps.APP_ALIASES); needed for their launch intents. -->
        <package android:name="com.whatsapp" />
        <package android:name="com.google.android.apps.nbu.paisa.user" />
        <package android:name="com.grofers.customerapp" />
        <package android:name="com.android.settings" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="Saathi"
        android:supportsRtl="true"
        android:theme="@style/Theme.Saathi">
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Reads the screen and performs taps for the offline task flows. Every action goes
             through app.saathi.safety.SafetyGate before it runs (hard rule 1). -->
        <service
            android:name=".agent.SaathiAccessibilityService"
            android:exported="false"
            android:label="Saathi"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>
</manifest>
