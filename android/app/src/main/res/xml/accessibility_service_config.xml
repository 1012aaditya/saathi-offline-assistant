<?xml version="1.0" encoding="utf-8"?>
<!-- Saathi reads the active window and acts only through app.saathi.safety.SafetyGate.
     Key-event filtering is for Volume-down push-to-talk (a short press still changes the volume).
     Screenshots: only for "what does this picture say?" in guide mode (demo builds, on request;
     never private apps, PIN / password or protected screens; see TaskRunner.lookAtScreen). -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged|typeWindowsChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds|flagRetrieveInteractiveWindows|flagRequestFilterKeyEvents|flagIncludeNotImportantViews"
    android:canPerformGestures="true"
    android:canRequestFilterKeyEvents="true"
    android:canRetrieveWindowContent="true"
    android:canTakeScreenshot="true"
    android:description="@string/a11y_service_description"
    android:notificationTimeout="100"
    android:summary="@string/a11y_service_summary" />
